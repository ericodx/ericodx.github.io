---
import PageHero from '../../components/PageHero.astro';
import Page from '../../layouts/Page.astro';

const tools = [
  {
    slug: 'swift-mutation-testing',
    name: 'swift-mutation-testing',
    description:
      'Measure and improve test effectiveness in Swift codebases using mutation testing.',
  },
  {
    slug: 'swift-cpd',
    name: 'swift-cpd',
    description:
      'Detect and eliminate duplicated logic in Swift and Objective-C/C codebases to improve maintainability and code quality.',
  },
  {
    slug: 'swift-marshal',
    name: 'swift-marshal',
    description:
      'Ensure consistent member ordering in Swift types to improve readability and maintainability.',
  },
];
---

<Page title="Open Source" description="Open source developer tools for Apple platforms">
  <PageHero
    title="Open Source"
    lead="Developer tools I build to keep Swift codebases honest. All MIT-licensed, distributed through my own Homebrew tap."
  >
    <div class="cards-grid">
      {
        tools.map((t) => (
          <a href={`/open-source/${t.slug}/`} class="card">
            <span class="card__title card__title--mono">{t.name}</span>
            <span class="card__body">{t.description}</span>
          </a>
        ))
      }
    </div>
  </PageHero>
</Page>
