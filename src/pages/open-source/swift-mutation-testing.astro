---
import ToolHero from '../../components/ToolHero.astro';
import Page from '../../layouts/Page.astro';

const sourceCode = `func isAdult(age: Int) -> Bool {
    return age >= 18
}

func test_isAdult() {
    XCTAssertTrue(isAdult(age: 20))
    XCTAssertFalse(isAdult(age: 10))
}`;

const mutatedCode = `func isAdult(age: Int) -> Bool {
    return age > 18  // mutated: >= → >
}

func test_isAdult() {
    XCTAssertTrue(isAdult(age: 20))  // still passes
    XCTAssertFalse(isAdult(age: 10)) // still passes
}`;

const features = [
  {
    title: 'Works with Xcode and SPM',
    body: 'Targets both project layouts. Auto-detects scheme, destination, and test targets on init.',
  },
  {
    title: 'XCTest and Swift Testing',
    body: 'Both frameworks are first-class. Mix them in the same project — the runner adapts.',
  },
  {
    title: 'Fast by default',
    body: 'Schematized execution builds the project once and switches mutants at runtime. SHA-based result caching avoids re-running unchanged code across CI builds.',
  },
  {
    title: 'CI-ready report formats',
    body: 'Text, HTML, JSON (Stryker-compatible), and SonarQube outputs. Drop a report into your pipeline and it just plugs in.',
  },
];

const docs = [
  {
    name: 'Installation',
    desc: 'Homebrew, pre-built binary, build from source',
    href: 'https://github.com/ericodx/swift-mutation-testing/blob/main/Docs/INSTALLATION.MD',
  },
  {
    name: 'Usage & Configuration',
    desc: 'CLI options, YAML config, output formats, CI integration',
    href: 'https://github.com/ericodx/swift-mutation-testing/blob/main/Docs/USAGE.MD',
  },
  {
    name: 'Mutation Results',
    desc: 'What each result means and when it occurs; schematizable vs incompatible mutants',
    href: 'https://github.com/ericodx/swift-mutation-testing/blob/main/Docs/MUTATION-RESULTS.md',
  },
  {
    name: 'Architecture',
    desc: 'Pipeline design, module map, schematization, execution model',
    href: 'https://github.com/ericodx/swift-mutation-testing/blob/main/Docs/Architecture/README.md',
  },
];
---

<Page
  title="Swift Mutation Testing"
  description="Measure and improve test effectiveness in Swift codebases using mutation testing."
>
  <ToolHero
    slug="swift-mutation-testing"
    title="Swift Mutation Testing"
    lead="Traditional test coverage tells you which lines ran — not whether the tests would actually catch a bug. Mutation testing introduces small, controlled changes to your code and re-runs your test suite. Every change that goes undetected exposes a missing assertion or a blind spot. The result is a mutation score that reflects how much your tests actually verify."
  />

  <section class="section-divider">
    <div class="wrap">
      <div class="stack-32">
        <div class="stack-12 content-width">
          <h2 class="h-section">Example mutation</h2>
          <p class="v-p300 text-text-t900">
            A small change to the source. If your tests still pass against the mutant, you have a
            gap — the test you thought protected this line doesn’t actually distinguish the original
            behavior from the change.
          </p>
        </div>
        <div class="cards-grid cards-grid--wide">
          <div class="stack-10">
            <span class="label">Source</span>
            <pre class="code-block">{sourceCode}</pre>
          </div>
          <div class="stack-10">
            <span class="label">Mutant</span>
            <pre class="code-block">{mutatedCode}</pre>
          </div>
        </div>
        <div class="content-width stack-16">
          <p class="v-p300 text-text-t900">
            A mutation test works by deliberately corrupting your code in small, controlled ways and
            then asking whether your test suite notices. The change above — <code
              class="inline-code">&gt;=</code
            > becoming <code class="inline-code">&gt;</code> — is a single mutation. swift-mutation-testing
            applies many of these across your code, runs your tests against each variant, and records
            the outcome. A mutation that passes the test suite is said to have <em>survived</em>;
            one that fails is <em>killed</em>.
          </p>
          <p class="v-p300 text-text-t900">
            What survival reveals is uncomfortable but useful: a test that ran, a line that was
            covered, an assertion that didn’t actually distinguish the original behavior from the
            corrupted one. Coverage tells you which lines your tests touched. Mutation testing tells
            you whether those tests would notice if the lines were wrong. The percentage of
            mutations killed — the mutation score — is a more honest read on test effectiveness than
            coverage alone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-divider">
    <div class="wrap">
      <div class="stack-32">
        <h2 class="h-section content-width">Features</h2>
        <div class="cards-grid cards-grid--narrow">
          {
            features.map((f) => (
              <div class="card">
                <span class="card__title">{f.title}</span>
                <span class="card__body">{f.body}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-divider section-divider--end">
    <div class="wrap">
      <div class="stack-32">
        <h2 class="h-section content-width">Documentation</h2>
        <div class="cards-grid">
          {
            docs.map((d) => (
              <a href={d.href} target="_blank" rel="noopener noreferrer" class="card">
                <span class="card__title">{d.name}</span>
                <span class="card__body">{d.desc}</span>
              </a>
            ))
          }
        </div>
        <a href="#top" class="back-to-top">↑ Back to top</a>
      </div>
    </div>
  </section>
</Page>
