---
import PageHero from '../components/PageHero.astro';
import Page from '../layouts/Page.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <PageHero
    title="Tools that keep Swift codebases honest"
    lead="I’m Érico, a software engineer working on developer productivity and tooling for Apple platforms. I share what I build as open source and write about what I learn."
  >
    <div class="flex w-full gap-2 sm:w-auto sm:items-center sm:gap-6">
      <a href="/open-source/" class="btn-primary">See what I’m building</a>
      <a href="/blog/" class="link-arrow">Read the blog<span aria-hidden="true">→</span></a>
    </div>
  </PageHero>
</Page>
