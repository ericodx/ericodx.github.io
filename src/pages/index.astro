---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section
        class="section-padding-x relative z-3 overflow-hidden bg-background-bg100 lg:pt-[240px] pb-10 pt-25 md:pb-15"
      >
        <div class="m-auto w-full xl:max-w-[1408px]">
          <div class="flex flex-col gap-7">
            <div class="flex flex-col gap-3">
              <div class="v-h900n tracking-[-2px] text-text-t900 md:max-w-none lg:tracking-[-3px]">
                <h1>Tools that keep Swift codebases honest</h1>
              </div>
              <div class="v-p300 text-text-t900 sm:max-w-[830px]">
                <p>
                  I’m Érico, a software engineer working on developer productivity and tooling for
                  Apple platforms. I share what I build as open source and write about what I learn.
                </p>
              </div>
            </div>
            <div class="flex w-full gap-2 sm:w-auto sm:items-center sm:gap-6">
              <a href="/open-source/" class="btn-primary">See what I’m building</a>
              <a href="/blog/" class="link-arrow">Read the blog<span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
