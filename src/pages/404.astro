---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Page not found" description="The page you were looking for doesn’t exist." />
  </head>
  <body>
    <Header />
    <main>
      <section class="section-hero">
        <div class="wrap">
          <div class="stack-32">
            <div class="stack-16">
              <h1 class="h-display">Not found</h1>
              <p class="v-p300 text-text-t900 sm:max-w-[830px]">
                The page you were looking for doesn’t exist. It may have been moved, renamed, or
                never existed in the first place.
              </p>
            </div>
            <a href="/" class="link-arrow self-start"
              ><span aria-hidden="true">←</span> Back to home</a
            >
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
