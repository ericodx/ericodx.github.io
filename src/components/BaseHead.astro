---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/tailwind.css';
import '../styles/site-base.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  ogImageUrl?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, ogImageUrl } = Astro.props;
const resolvedOgImage = ogImageUrl ? new URL(ogImageUrl, Astro.site).toString() : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=6" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<ClientRouter />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph (used by LinkedIn, Mastodon, Facebook, etc.) -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
{resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
{resolvedOgImage && <meta property="og:image:width" content="1200" />}
{resolvedOgImage && <meta property="og:image:height" content="630" />}
