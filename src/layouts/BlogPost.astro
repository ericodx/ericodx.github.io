---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Page from './Page.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { readingTime: number };

const { title, description, pubDate, updatedDate, heroImage, readingTime } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const authorURL = new URL('/about/', Astro.site).toString();

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: SITE_TITLE,
    url: authorURL,
  },
  url: canonicalURL,
  mainEntityOfPage: canonicalURL,
};
if (updatedDate) {
  jsonLd.dateModified = updatedDate.toISOString();
}
if (heroImage) {
  jsonLd.image = new URL(heroImage.src, Astro.site).toString();
}
---

<Page title={title} description={description} image={heroImage}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <section class="section-hero">
    <div class="wrap">
      <div class="stack-32">
        <div class="stack-16">
          <h1 class="h-display">{title}</h1>
          <span class="label">
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <>
                  {' · Updated '}
                  <FormattedDate date={updatedDate} />
                </>
              )
            }
            {` · ${readingTime} min read`}
          </span>
        </div>

        {
          heroImage && (
            <Image
              width={1020}
              height={510}
              src={heroImage}
              alt=""
              style="max-width:100%;height:auto;border-radius:12px;"
            />
          )
        }

        <article class="post-body">
          <slot />
        </article>

        <a href="/blog/" class="link-arrow self-start"
          ><span aria-hidden="true">←</span> Back to blog</a
        >
      </div>
    </div>
  </section>
</Page>
